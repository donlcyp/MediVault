@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid py-5">
    <div class="row align-items-center g-5 py-4">
        <!-- Hero Text -->
        <div class="col-lg-6">
            <div class="badge-role badge-admin mb-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-shield-fill-check"></i> Enterprise Grade Security
            </div>
            <h1 class="display-3 fw-bold mb-3 leading-tight">
                Secure Patient Records <br/>
                <span class="text-gradient">Fully Encrypted.</span>
            </h1>
            <p class="lead text-muted mb-4" style="max-width: 550px; font-size: 1.15rem;">
                MediVault is a next-generation Hospital Information System implementing application-level AES-256 encryption, strict Role-Based Access Control, and real-time verifiable cryptographic audit trails.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a class="btn-premium-primary px-4 py-3 text-decoration-none" asp-area="Identity" asp-page="/Account/Login">
                    <i class="bi bi-box-arrow-in-right"></i> Access Portal
                </a>
            </div>
        </div>

        <!-- Floating High-Tech Shield graphic -->
        <div class="col-lg-6 text-center position-relative">
            <div class="position-absolute top-50 start-50 translate-middle" style="width: 400px; height: 400px; background: radial-gradient(circle, rgba(0,242,254,0.12) 0%, transparent 70%); z-index: -1;"></div>
            <!-- Custom SVG representation of the Shield logo with Document, Lock and checklist -->
            <svg width="240" height="240" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" style="animation: float 6s ease-in-out infinite; filter: drop-shadow(0 0 25px rgba(0, 242, 254, 0.25));">
                <path d="M18 3L6 8v10c0 7.2 5.4 13 12 15 6.6-2 12-7.8 12-15V8l-12-5z" fill="url(#heroShield)" stroke="#00F2FE" stroke-width="1.2"/>
                <path d="M11 10h14v12H11V10z" fill="#090E17" rx="1.5" stroke="rgba(255,255,255,0.06)" />
                <!-- Plus inside document -->
                <path d="M15 15h6M18 12v6" stroke="#4FACFE" stroke-width="1.5" stroke-linecap="round"/>
                <!-- Padlock -->
                <rect x="16" y="20" width="4" height="3" rx="0.5" fill="#00F2FE" />
                <path d="M17 20v-1.5a1 1 0 012 0V20" stroke="#00F2FE" stroke-width="0.8" fill="none" />
                <!-- Green check badge on bottom right -->
                <circle cx="27" cy="27" r="5.5" fill="#10B981" stroke="#0B0F19" stroke-width="1.5" />
                <path d="M25 27l1.5 1.5 2.5-2.5" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                
                <defs>
                    <linearGradient id="heroShield" x1="6" y1="3" x2="30" y2="33" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#1E293B"/>
                        <stop offset="1" stop-color="#0B0F19"/>
                    </linearGradient>
                </defs>
            </svg>
        </div>
    </div>

    <!-- Core Security Pillars -->
    <div class="row g-4 mb-5 mt-4">
        <div class="col-md-4">
            <div class="card-custom h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 mb-3" style="background: rgba(0, 242, 254, 0.08); color: var(--accent-cyan);">
                    <i class="bi bi-lock-fill fs-3"></i>
                </div>
                <h4 class="card-title">AES-256 Encryption</h4>
                <p class="text-muted mb-0">
                    Patient medical history, diagnoses, and prescriptions are encrypted in the database at the application level. Decryption happens dynamically only when a user with proper clearance accesses the record.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-custom h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 mb-3" style="background: rgba(99, 102, 241, 0.08); color: var(--color-patient);">
                    <i class="bi bi-person-check-fill fs-3"></i>
                </div>
                <h4 class="card-title">Granular Access Control</h4>
                <p class="text-muted mb-0">
                    Strict role configurations differentiate between Doctors, Nurses, Records Officers, and Admins. For example, system administrators have zero visibility into patient medical records.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-custom h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 mb-3" style="background: rgba(16, 185, 129, 0.08); color: var(--color-nurse);">
                    <i class="bi bi-file-earmark-lock2-fill fs-3"></i>
                </div>
                <h4 class="card-title">Immutable Audit Trails</h4>
                <p class="text-muted mb-0">
                    Every read operation, data modification, key shift, and login attempt creates a detailed audit event. These events cannot be altered or deleted by any user level.
                </p>
            </div>
        </div>
    </div>

    <!-- Demo Accounts Panel -->
    <div class="card-custom p-4 mt-5">
        <div class="row align-items-center">
            <div class="col-lg-5 mb-4 mb-lg-0">
                <h3 class="mb-2"><i class="bi bi-key-fill text-gradient"></i> Demo Simulator Access</h3>
                <p class="text-muted mb-0">
                    We have configured standard accounts representing each organizational role in the hospital structure. Select any role below to view credentials, then click "Access Portal" to log in.
                </p>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-sm-6 col-md-4">
                        <div class="p-3 rounded-3 border border-secondary border-opacity-10 text-center" style="background: rgba(255, 255, 255, 0.01);">
                            <span class="badge-role badge-admin d-block mb-2">Admin</span>
                            <code class="small d-block mb-1 text-white">admin@medivault.com</code>
                            <small class="text-muted">Password: Admin@12345</small>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <div class="p-3 rounded-3 border border-secondary border-opacity-10 text-center" style="background: rgba(255, 255, 255, 0.01);">
                            <span class="badge-role badge-doctor d-block mb-2">Doctor</span>
                            <code class="small d-block mb-1 text-white">doctor@medivault.com</code>
                            <small class="text-muted">Password: Doctor@12345</small>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <div class="p-3 rounded-3 border border-secondary border-opacity-10 text-center" style="background: rgba(255, 255, 255, 0.01);">
                            <span class="badge-role badge-nurse d-block mb-2">Nurse</span>
                            <code class="small d-block mb-1 text-white">nurse@medivault.com</code>
                            <small class="text-muted">Password: Nurse@12345</small>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <div class="p-3 rounded-3 border border-secondary border-opacity-10 text-center" style="background: rgba(255, 255, 255, 0.01);">
                            <span class="badge-role badge-records d-block mb-2">Records</span>
                            <code class="small d-block mb-1 text-white">records@medivault.com</code>
                            <small class="text-muted">Password: Records@12345</small>
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-4 d-flex align-items-center justify-content-center">
                        <a class="btn-premium-primary text-center w-100 text-decoration-none py-3" asp-area="Identity" asp-page="/Account/Login">
                            <i class="bi bi-unlock-fill"></i> Sign In
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-12px) rotate(1deg); }
    }
</style>
