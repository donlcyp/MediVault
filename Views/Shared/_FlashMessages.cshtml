@{
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success border border-success border-opacity-10 bg-transparent text-success d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger border border-danger border-opacity-10 bg-transparent text-danger d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@errorMessage</span>
    </div>
}