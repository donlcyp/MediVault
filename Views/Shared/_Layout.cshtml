<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediVault</title>
    
    <!-- Google Fonts & Icon Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    
    <!-- Bootstrap & Site Overrides -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MediVault.styles.css" asp-append-version="true" />
    <!-- Prevent Theme Flicker -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body class="app-shell">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/medivault-logo.png"
                         alt="MediVault logo"
                         width="36"
                         height="36"
                         class="me-1"
                         style="object-fit: contain; filter: drop-shadow(0 0 4px rgba(0, 242, 254, 0.35));" />
                    <span class="fs-4 fw-bold"><span style="color: #4facfe;">Medi</span><span class="text-gradient">Vault</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!(User.Identity?.IsAuthenticated ?? false))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                    <i class="bi bi-shield-lock"></i> Privacy
                                </a>
                            </li>
                        }
                    </ul>
                    <!-- Theme Toggle Toggle -->
                    <div class="d-flex align-items-center me-3 my-2 my-lg-0">
                        <button id="themeToggleBtn" type="button" class="btn btn-link nav-link p-0 rounded-circle border-0 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: rgba(255,255,255,0.05); color: var(--text-muted); cursor: pointer;" title="Toggle Light/Dark Theme">
                            <i id="themeToggleIcon" class="bi bi-moon-stars-fill text-gradient" style="font-size: 1.15rem;"></i>
                        </button>
                    </div>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    <div class="app-surface">
        <main role="main" class="app-main pb-5 min-vh-100">
            <partial name="_FlashMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom mt-auto">
        <div class="container text-center text-md-start">
            <div class="row align-items-center">
                <div class="col-md-6 mb-3 mb-md-0">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-2">
                        <span class="fw-bold"><span style="color: #4facfe;">Medi</span><span class="text-gradient">Vault</span></span>
                        <span class="badge bg-secondary" style="font-size: 0.7rem;">v1.0.0</span>
                    </div>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-shield-fill-check text-gradient"></i> Secure Hospital Information System. Encrypted & Audited.
                    </p>
                </div>
                <div class="col-md-6 text-md-end text-center">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3 hover-cyan">Privacy Policy</a>
                    <span class="text-muted">|</span>
                    <span class="text-muted ms-3">&copy; 2026 MediVault Development</span>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Theme toggle functionality
            const themeBtn = document.getElementById('themeToggleBtn');
            const themeIcon = document.getElementById('themeToggleIcon');
            
            if (themeBtn) {
                const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
                updateThemeIcon(currentTheme);

                themeBtn.addEventListener('click', () => {
                    const activeTheme = document.documentElement.getAttribute('data-theme') || 'dark';
                    const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                    
                    document.documentElement.setAttribute('data-theme', newTheme);
                    localStorage.setItem('theme', newTheme);
                    updateThemeIcon(newTheme);
                });
            }

            function updateThemeIcon(theme) {
                if (themeIcon) {
                    if (theme === 'light') {
                        themeIcon.className = 'bi bi-sun-fill text-gradient';
                        themeIcon.style.color = '#f59e0b';
                    } else {
                        themeIcon.className = 'bi bi-moon-stars-fill text-gradient';
                        themeIcon.style.color = '';
                    }
                }
            }

            // Custom dropdown implementation with enhanced debugging
            const dropdownTrigger = document.getElementById('customUserDropdown');
            const dropdownMenu = document.getElementById('customDropdownMenu');
            
            console.log('Dropdown elements found:', {
                trigger: !!dropdownTrigger,
                menu: !!dropdownMenu
            });
            
            if (dropdownTrigger && dropdownMenu) {
                let isOpen = dropdownMenu.classList.contains('show');
                
                // Toggle dropdown
                dropdownTrigger.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Dropdown trigger clicked');
                    
                    isOpen = !isOpen;
                    if (isOpen) {
                        dropdownMenu.classList.add('show');
                        dropdownTrigger.setAttribute('aria-expanded', 'true');
                        console.log('Dropdown opened');
                    } else {
                        dropdownMenu.classList.remove('show');
                        dropdownTrigger.setAttribute('aria-expanded', 'false');
                        console.log('Dropdown closed');
                    }
                });
                
                // Close dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    if (!dropdownTrigger.contains(e.target) && !dropdownMenu.contains(e.target)) {
                        if (isOpen) {
                            isOpen = false;
                            dropdownMenu.classList.remove('show');
                            dropdownTrigger.setAttribute('aria-expanded', 'false');
                            console.log('Dropdown closed (outside click)');
                        }
                    }
                });
                
                // Handle Account Settings link
                const accountSettingsLink = dropdownMenu.querySelector('a[href*="Account/Manage"]');
                if (accountSettingsLink) {
                    accountSettingsLink.addEventListener('click', function(e) {
                        console.log('Account Settings clicked - navigating to:', this.href);
                        // Let the default navigation happen
                    });
                }
                
                // Handle logout form submission with multiple approaches
                const logoutForm = dropdownMenu.querySelector('.logout-form-custom');
                const logoutButton = dropdownMenu.querySelector('.logout-btn');
                
                console.log('Logout elements found:', {
                    form: !!logoutForm,
                    button: !!logoutButton
                });
                
                if (logoutForm && logoutButton) {
                    // Method 1: Button click handler
                    logoutButton.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        console.log('Logout button clicked - submitting form');
                        console.log('Form action:', logoutForm.action);
                        logoutForm.submit();
                    });
                    
                    // Method 2: Form submit handler
                    logoutForm.addEventListener('submit', function(e) {
                        console.log('Logout form submitting');
                        // Let the form submit normally
                    });
                    
                    // Method 3: Direct form submission on mousedown (backup)
                    logoutButton.addEventListener('mousedown', function(e) {
                        console.log('Logout button mousedown');
                    });
                }
                
                // Additional safety: Make all dropdown items explicitly clickable
                const allDropdownItems = dropdownMenu.querySelectorAll('.custom-dropdown-item');
                allDropdownItems.forEach((item, index) => {
                    item.style.pointerEvents = 'auto';
                    item.style.cursor = 'pointer';
                    console.log(`Dropdown item ${index + 1} made clickable:`, item.textContent.trim());
                    
                    // Add click debugging
                    item.addEventListener('mouseenter', function() {
                        console.log('Hovering over:', this.textContent.trim());
                    });
                });
            }
            
            // Legacy logout form handler (safety net)
            const legacyLogoutForm = document.getElementById('logoutForm');
            if (legacyLogoutForm) {
                console.log('Legacy logout form found');
                const legacyLogoutButton = legacyLogoutForm.querySelector('button[type="submit"]');
                if (legacyLogoutButton) {
                    legacyLogoutButton.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        console.log('Legacy logout button clicked');
                        legacyLogoutForm.submit();
                    });
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
