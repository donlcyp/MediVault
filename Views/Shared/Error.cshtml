@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card-custom p-4 p-md-5 text-center">
                <div class="badge-role badge-admin mb-3 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @Model.StatusCode
                </div>
                <h1 class="display-5 fw-bold mb-3">@Model.Title</h1>
                <p class="lead text-muted mb-4">@Model.Message</p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        <strong>Request ID:</strong> @Model.RequestId
                    </p>
                }

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a class="btn-premium-primary px-4 py-3 text-decoration-none" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i> Return Home
                    </a>
                    <a class="btn btn-outline-light px-4 py-3" asp-controller="Home" asp-action="Privacy">
                        Privacy Policy
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
