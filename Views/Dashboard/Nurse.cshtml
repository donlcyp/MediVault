@{
    ViewData["Title"] = "Nurse Dashboard";
    var patientRecords = (List<MediVault.Models.PatientRecord>)ViewBag.PatientRecords ?? new List<MediVault.Models.PatientRecord>();
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-sm-8">
            <h1 class="h2 mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-heart-pulse text-gradient" style="color: var(--color-nurse);"></i> 
                <span>Nurse Dashboard</span>
            </h1>
            <p class="text-muted mb-0">Record vitals, log daily nursing care logs, and monitor clinical status.</p>
        </div>
        <div class="col-sm-4 text-sm-end">
            <span class="badge-role badge-nurse px-3 py-2 fs-7"><i class="bi bi-activity"></i> Care Team Access</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border border-success border-opacity-10 bg-transparent text-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border border-danger border-opacity-10 bg-transparent text-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        </div>
    }

    <!-- Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="metric-box">
                <div class="metric-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--color-nurse);">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="ms-3">
                    <span class="d-block text-muted small">Assigned Patients</span>
                    <h3 class="mb-0 fw-bold">@patientRecords.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="metric-box">
                <div class="metric-icon" style="background: rgba(2, 132, 199, 0.1); color: var(--color-doctor);">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <div class="ms-3">
                    <span class="d-block text-muted small">Active Vitals Logged</span>
                    <h3 class="mb-0 fw-bold">@patientRecords.Count(x => !string.IsNullOrEmpty(x.MedicalHistoryEncrypted))</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-12">
            <div class="metric-box">
                <div class="metric-icon" style="background: rgba(245, 158, 11, 0.1); color: var(--color-records);">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div class="ms-3">
                    <span class="d-block text-muted small">Shift Checklist Completed</span>
                    <h3 class="mb-0 fw-bold">@patientRecords.Count(x => x.Status == "Stable") Stable</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Patient Care Overview -->
    <div class="card-custom">
        <div class="card-header bg-transparent">
            <h5 class="mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-clipboard-pulse text-gradient"></i> Patient Care Overview
            </h5>
        </div>
        <div class="card-body p-4">
            @if (patientRecords.Any())
            {
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Patient ID</th>
                                <th>Name</th>
                                <th>Age</th>
                                <th>Diagnosis</th>
                                <th>Vitals & History</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in patientRecords)
                            {
                                <tr>
                                    <td><code class="text-gradient fw-bold">#@record.Id.ToString("D4")</code></td>
                                    <td class="fw-semibold">@record.PatientName</td>
                                    <td>@record.Age yrs</td>
                                    <td><span class="text-muted">@record.Diagnosis</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 border-opacity-25" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#careNotesModal-@record.Id">
                                            <i class="bi bi-plus-circle"></i> Log Notes
                                        </button>
                                    </td>
                                    <td>
                                        <span class="badge-status badge-@record.Status.ToLower()">@record.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("ViewPatient", "Dashboard", new { id = record.Id })" class="btn-premium-secondary py-1 px-3 fs-8">
                                            <i class="bi bi-eye"></i> View Chart
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info border border-info border-opacity-10 bg-transparent text-info d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>No assigned patients under clinical care.</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Care Notes Modals -->
@foreach (var record in patientRecords)
{
    <div class="modal fade nurse-note-modal" id="careNotesModal-@record.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 glass-panel p-2">
                <form asp-action="AddCareNote" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@record.Id" />
                    
                    <div class="modal-header border-bottom border-secondary border-opacity-10 py-3">
                        <h5 class="modal-title d-flex align-items-center gap-2 text-white">
                            <i class="bi bi-file-earmark-medical-fill text-gradient" style="color: var(--color-nurse);"></i>
                            <span>Add Care Note &mdash; @record.PatientName</span>
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Enter clinical updates, vitals check or care details (these notes are encrypted on submission):</label>
                            <textarea name="careNote" class="form-control form-input-custom" rows="5" placeholder="e.g., BP: 120/80, Temp: 37.1 C. Patient resting comfortably." required></textarea>
                        </div>
                    </div>
                    
                    <div class="modal-footer border-top border-secondary border-opacity-10 py-3">
                        <button type="button" class="btn btn-premium-secondary py-2" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-premium-primary py-2">
                            <i class="bi bi-shield-fill-check"></i> Encrypt & Save Notes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

