@{
    ViewData["Title"] = "System Environment Settings";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-sm-8">
            <h1 class="h2 mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-gear-wide-connected text-gradient" style="color: var(--color-admin);"></i> 
                <span>System Parameters & Settings</span>
            </h1>
            <p class="text-muted mb-0">System details, environment settings, and cryptographic protocols.</p>
        </div>
        <div class="col-sm-4 text-sm-end">
            <a class="btn-premium-secondary py-2 px-3 text-decoration-none" asp-action="Admin">
                <i class="bi bi-arrow-left"></i> Admin Panel
            </a>
        </div>
    </div>

    <!-- Details Card -->
    <div class="card-custom">
        <div class="card-header bg-transparent py-3">
            <h5 class="mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-server text-gradient"></i> Core Infrastructure Profile
            </h5>
        </div>
        <div class="card-body p-4 p-sm-5">
            <div class="row g-4">
                <div class="col-md-6 border-end border-secondary border-opacity-10">
                    <div class="d-flex flex-column gap-4">
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-10">
                            <span class="text-muted"><i class="bi bi-window me-2"></i>Application Name</span>
                            <span class="fw-semibold text-white">MediVault HIS</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-10">
                            <span class="text-muted"><i class="bi bi-code-square me-2"></i>Execution Framework</span>
                            <span class="fw-semibold text-white">ASP.NET Core (v10.0)</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-10">
                            <span class="text-muted"><i class="bi bi-cloud-check-fill me-2"></i>Deployment Channel</span>
                            <span class="fw-semibold text-white font-monospace text-gradient">Development</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex flex-column gap-4">
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-10">
                            <span class="text-muted"><i class="bi bi-fingerprint me-2"></i>Identity Engine</span>
                            <span class="fw-semibold text-white">ASP.NET Core Identity</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-10">
                            <span class="text-muted"><i class="bi bi-shield-fill-lock me-2"></i>Encryption Protocol</span>
                            <span class="fw-semibold text-success font-monospace">AES-256 (Application-Level)</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-10">
                            <span class="text-muted"><i class="bi bi-journal-text me-2"></i>Audit Log Status</span>
                            <span class="fw-semibold text-success font-monospace">ENABLED</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
