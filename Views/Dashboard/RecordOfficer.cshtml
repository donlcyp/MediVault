@{
    ViewData["Title"] = "Record Officer Dashboard";
    var patientRecords = (List<MediVault.Models.PatientRecord>)ViewBag.PatientRecords ?? new List<MediVault.Models.PatientRecord>();
    var appointments = (List<MediVault.Models.Appointment>)ViewBag.Appointments ?? new List<MediVault.Models.Appointment>();
    var billingRecords = (List<MediVault.Models.BillingRecord>)ViewBag.BillingRecords ?? new List<MediVault.Models.BillingRecord>();
    var activeAppointments = appointments.Count(x => x.Status == "Scheduled");
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-sm-8">
            <h1 class="h2 mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-medical text-gradient" style="color: var(--color-records);"></i> 
                <span>Record Officer Dashboard</span>
            </h1>
            <p class="text-muted mb-0">Manage scheduling, demographics, billing, and print official compliance reports.</p>
        </div>
        <div class="col-sm-4 text-sm-end">
            <span class="badge-role badge-records px-3 py-2 fs-7"><i class="bi bi-archive-fill"></i> Records Department Access</span>
        </div>
    </div>

    <!-- Key Metrics Grid -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="metric-box">
                <div class="metric-icon" style="background: rgba(245, 158, 11, 0.1); color: var(--color-records);">
                    <i class="bi bi-archive-fill"></i>
                </div>
                <div class="ms-3">
                    <span class="d-block text-muted small">Total Patient Records</span>
                    <h3 class="mb-0 fw-bold">@patientRecords.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="metric-box">
                <div class="metric-icon" style="background: rgba(2, 132, 199, 0.1); color: var(--color-doctor);">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
                <div class="ms-3">
                    <span class="d-block text-muted small">Scheduled Appointments</span>
                    <h3 class="mb-0 fw-bold">@activeAppointments Active</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-12">
            <div class="metric-box">
                <div class="metric-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--color-nurse);">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div class="ms-3">
                    <span class="d-block text-muted small">Billing Operations</span>
                    <h3 class="mb-0 fw-bold">@billingRecords.Count(x => x.Status == "Pending") Pending</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Scheduling & Billing Management Grid -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card-custom h-100">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
                    <h5 class="mb-0 d-flex align-items-center gap-2 text-white">
                        <i class="bi bi-calendar-check text-gradient" style="color: var(--color-records);"></i> Appointment Scheduling
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ScheduleAppointment" method="post" class="row g-3 mb-4">
                        @Html.AntiForgeryToken()
                        <div class="col-md-5">
                            <label class="form-label text-muted small">Patient</label>
                            <select name="patientRecordId" class="form-select form-input-custom" required>
                                @foreach (var record in patientRecords)
                                {
                                    <option value="@record.Id">#@record.Id.ToString("D4") - @record.PatientName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Date and Time</label>
                            <input type="datetime-local" name="scheduledAt" class="form-control form-input-custom" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Purpose</label>
                            <input type="text" name="purpose" class="form-control form-input-custom" placeholder="Follow-up" required />
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-sm btn-outline-warning border-opacity-25" style="border-radius: 8px;">
                                <i class="bi bi-plus-lg"></i> Book Appointment
                            </button>
                        </div>
                    </form>

                    @if (appointments.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var appointment in appointments.Take(5))
                            {
                                <div class="border border-secondary border-opacity-10 rounded-3 p-3">
                                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
                                        <div>
                                            <div class="fw-semibold">@appointment.PatientRecord?.PatientName</div>
                                            <small class="text-muted">@appointment.Purpose</small>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted d-block">@appointment.ScheduledAt.ToString("g")</small>
                                            <span class="badge-status @(appointment.Status == "Cancelled" ? "badge-critical" : "badge-stable")">@appointment.Status</span>
                                        </div>
                                    </div>
                                    @if (appointment.Status != "Cancelled")
                                    {
                                        <div class="d-flex justify-content-end align-items-center gap-2 flex-wrap">
                                            <form asp-action="RescheduleAppointment" method="post" class="d-inline-flex align-items-center gap-2 flex-wrap">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="datetime-local" name="scheduledAt" class="form-control form-input-custom py-1" value="@appointment.ScheduledAt.ToString("yyyy-MM-ddTHH:mm")" style="width: 190px; font-size: 0.85rem;" required />
                                                <button type="submit" class="btn btn-sm btn-outline-info border-opacity-25" style="border-radius: 8px;">
                                                    <i class="bi bi-calendar2-week"></i> Reschedule
                                                </button>
                                            </form>
                                            <form asp-action="CancelAppointment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-opacity-25" style="border-radius: 8px;">
                                                    <i class="bi bi-x-circle"></i> Cancel
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info border border-info border-opacity-10 bg-transparent text-info d-flex align-items-center gap-2 mb-0">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>No appointments scheduled.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card-custom h-100">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
                    <h5 class="mb-0 d-flex align-items-center gap-2 text-white">
                        <i class="bi bi-receipt text-gradient" style="color: var(--color-nurse);"></i> Billing Records
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="GenerateBill" method="post" class="row g-3 mb-4">
                        @Html.AntiForgeryToken()
                        <div class="col-md-5">
                            <label class="form-label text-muted small">Patient</label>
                            <select name="patientRecordId" class="form-select form-input-custom" required>
                                @foreach (var record in patientRecords)
                                {
                                    <option value="@record.Id">#@record.Id.ToString("D4") - @record.PatientName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Description</label>
                            <input type="text" name="description" class="form-control form-input-custom" placeholder="Consultation fee" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Amount</label>
                            <input type="number" name="amount" class="form-control form-input-custom" min="0.01" step="0.01" placeholder="0.00" required />
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-sm btn-outline-success border-opacity-25" style="border-radius: 8px;">
                                <i class="bi bi-plus-lg"></i> Generate Bill
                            </button>
                        </div>
                    </form>

                    @if (billingRecords.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var bill in billingRecords.Take(4))
                            {
                                <div class="d-flex justify-content-between align-items-center border border-secondary border-opacity-10 rounded-3 p-2 gap-3 flex-wrap">
                                    <div>
                                        <div class="fw-semibold">@bill.PatientRecord?.PatientName</div>
                                        <small class="text-muted">@bill.Description - @bill.Amount.ToString("C")</small>
                                    </div>
                                    <div class="d-inline-flex align-items-center gap-2 flex-wrap">
                                        <a asp-action="ExportBillPdf" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-danger border-opacity-25" style="border-radius: 8px;">
                                            <i class="bi bi-filetype-pdf"></i> Invoice
                                        </a>
                                        @if (bill.Status == "Pending")
                                        {
                                            <form asp-action="MarkBillPaid" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@bill.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success border-opacity-25" style="border-radius: 8px;">Mark Paid</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge-status badge-stable">Paid</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info border border-info border-opacity-10 bg-transparent text-info d-flex align-items-center gap-2 mb-0">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>No outstanding or generated bills active.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Patient Records Directory -->
    <div class="card-custom">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
            <h5 class="mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-file-medical text-gradient"></i> All Patient Records Directory
            </h5>
            <div>
                <input type="search" class="form-control form-input-custom py-1 px-3" placeholder="Search records..." style="width: 240px; font-size: 0.85rem;">
            </div>
        </div>
        <div class="card-body p-4">
            @if (patientRecords.Any())
            {
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Patient ID</th>
                                <th>Name</th>
                                <th>Age</th>
                                <th>Admission Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in patientRecords)
                            {
                                <tr>
                                    <td><code class="text-gradient fw-bold">#@record.Id.ToString("D4")</code></td>
                                    <td class="fw-semibold">@record.PatientName</td>
                                    <td>@record.Age yrs</td>
                                    <td>
                                        <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@record.DateAdmitted.ToString("d")</small>
                                    </td>
                                    <td>
                                        <span class="badge-status badge-@record.Status.ToLower()">@record.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a href="@Url.Action("PrintPatient", "Dashboard", new { id = record.Id })" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 py-1 px-3 border-opacity-25" style="border-radius: 10px;">
                                                <i class="bi bi-printer"></i> Print Redacted
                                            </a>
                                            <a href="@Url.Action("ExportPatientPdf", "Dashboard", new { id = record.Id })" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 py-1 px-3 border-opacity-25" style="border-radius: 10px;">
                                                <i class="bi bi-filetype-pdf"></i> PDF
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info border border-info border-opacity-10 bg-transparent text-info d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>No patient records logged in directory.</span>
                </div>
            }
        </div>
    </div>
</div>
