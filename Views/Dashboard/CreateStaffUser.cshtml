@model MediVault.ViewModels.CreateStaffUserViewModel
@{
    ViewData["Title"] = "Create Staff Account";
    var staffRoles = (string[])ViewBag.StaffRoles;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-sm-8">
            <h1 class="h2 mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-person-plus text-gradient" style="color: var(--color-admin);"></i> 
                <span>Create Staff Account</span>
            </h1>
            <p class="text-muted mb-0">Provision organizational staff credentials. All events are recorded in the immutable security audit log.</p>
        </div>
        <div class="col-sm-4 text-sm-end">
            <a class="btn-premium-secondary py-2 px-3 text-decoration-none" asp-action="UserManagement">
                <i class="bi bi-arrow-left"></i> Cancel & Return
            </a>
        </div>
    </div>

    <!-- Form Container -->
    <div class="card-custom mx-auto" style="max-width: 600px;">
        <div class="card-header bg-transparent d-flex align-items-center gap-2">
            <i class="bi bi-shield-fill-check text-gradient"></i>
            <h5 class="mb-0">Secure Credential Provisioning Form</h5>
        </div>
        <div class="card-body p-4 p-sm-5">
            <form asp-action="CreateStaffUser" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4" role="alert"></div>

                <div class="row g-4">
                    <!-- Email Address -->
                    <div class="col-12">
                        <label asp-for="Email" class="form-label text-muted small"><i class="bi bi-envelope-fill me-1"></i>Email Address</label>
                        <input asp-for="Email" class="form-control form-input-custom" placeholder="staff@medivault.com" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label text-muted small"><i class="bi bi-key-fill me-1"></i>Password</label>
                        <input asp-for="Password" class="form-control form-input-custom" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label text-muted small"><i class="bi bi-key-fill me-1"></i>Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control form-input-custom" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Staff Role -->
                    <div class="col-12">
                        <label asp-for="Role" class="form-label text-muted small"><i class="bi bi-shield-fill me-1"></i>Staff Clearance Role</label>
                        <select asp-for="Role" class="form-select form-input-custom">
                            <option value="">Select staff role and security clearance...</option>
                            @foreach (var role in staffRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <!-- Actions -->
                    <div class="col-12 pt-3">
                        <button type="submit" class="w-100 btn btn-premium-primary py-3">
                            <i class="bi bi-person-plus-fill me-1"></i> Provision Account
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
