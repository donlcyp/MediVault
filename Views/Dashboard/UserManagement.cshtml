@model IList<MediVault.ViewModels.UserManagementViewModel>
@{
    ViewData["Title"] = "User Management";
    var allRoles = (string[])ViewBag.AllRoles;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-sm-8">
            <h1 class="h2 mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-people text-gradient" style="color: var(--color-admin);"></i> 
                <span>User Management</span>
            </h1>
            <p class="text-muted mb-0">View user accounts, verification status, and enable/disable user access.</p>
        </div>
        <div class="col-sm-4 text-sm-end d-flex justify-content-sm-end gap-2">
            <a class="btn-premium-primary py-2 px-3 text-decoration-none" asp-action="CreateStaffUser">
                <i class="bi bi-person-plus-fill"></i> Add User
            </a>
            <a class="btn-premium-secondary py-2 px-3 text-decoration-none" asp-action="Admin">
                <i class="bi bi-arrow-left"></i> Admin Panel
            </a>
        </div>
    </div>

    <!-- Users Grid -->
    <div class="card-custom">
        <div class="card-header bg-transparent py-3">
            <h5 class="mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock text-gradient"></i> Active System Directory
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>User Email</th>
                            <th>Account Status</th>
                            <th>Verification Status</th>
                            <th>Current Clearance</th>
                            <th class="text-end" style="width: 350px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr class="@(!user.IsEnabled ? "opacity-75" : "")">
                                <td class="fw-semibold @(!user.IsEnabled ? "text-muted" : "")">
                                    @user.Email
                                    @if (!user.IsEnabled)
                                    {
                                        <small class="text-muted d-block">(Disabled)</small>
                                    }
                                </td>
                                <td>
                                    @if (user.IsEnabled)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="border-radius: 6px;">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" style="border-radius: 6px;">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="border-radius: 6px;">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25" style="border-radius: 6px;">Pending</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var primaryRole = user.Roles.FirstOrDefault() ?? "None";
                                    }
                                    @if (primaryRole == "SystemAdministrator")
                                    {
                                        <span class="badge-role badge-admin">Admin</span>
                                    }
                                    else if (primaryRole == "Doctor")
                                    {
                                        <span class="badge-role badge-doctor">Doctor</span>
                                    }
                                    else if (primaryRole == "Nurse")
                                    {
                                        <span class="badge-role badge-nurse">Nurse</span>
                                    }
                                    else if (primaryRole == "RecordOfficer")
                                    {
                                        <span class="badge-role badge-records">Records</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25" style="border-radius: 6px; font-size: 0.75rem;">None</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2 align-items-center">
                                        <span class="text-muted small fst-italic">Role editing disabled</span>
                                        
                                        <!-- Enable/Disable Button -->
                                        <form asp-action="ToggleUserStatus" method="post" class="mb-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="UserId" value="@user.Id" />
                                            <input type="hidden" name="IsEnabled" value="@(!user.IsEnabled)" />
                                            @if (user.IsEnabled)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning py-1" title="Disable User" onclick="return confirm('Are you sure you want to disable this user? They will not be able to log in.');">
                                                    <i class="bi bi-pause-circle"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success py-1" title="Enable User" onclick="return confirm('Are you sure you want to enable this user?');">
                                                    <i class="bi bi-play-circle"></i>
                                                </button>
                                            }
                                        </form>
                                        
                                        <form asp-action="DeleteUser" method="post" class="mb-0" onsubmit="return confirm('Are you sure you want to delete this user? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1" title="Delete User">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
