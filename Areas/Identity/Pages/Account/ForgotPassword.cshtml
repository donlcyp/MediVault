@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="container-fluid site-section">
    <div class="auth-shell auth-shell--centered">
        <section class="surface-panel auth-form auth-form--centered">
            <div class="auth-form-inner">
                <div class="auth-form-card">
                    <span class="section-kicker"><i class="bi bi-envelope-paper"></i> Recovery flow</span>
                    <h1 class="auth-form-title mt-3 mb-2 fw-bold">Forgot your password?</h1>
                    <p class="auth-form-subtitle mb-4">Enter your email address and we’ll send the reset instructions if an account exists.</p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>
                        <div class="auth-field mb-3">
                            <label asp-for="Input.Email" class="form-label">Email Address</label>
                            <input asp-for="Input.Email" class="form-control form-input-custom" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-premium-primary py-3">Reset Password</button>
                    </form>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
