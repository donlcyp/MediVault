@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked out";
}

<div class="container-fluid site-section">
    <div class="auth-shell auth-shell--centered">
        <section class="surface-panel auth-form auth-form--centered">
            <div class="auth-form-inner">
                <div class="auth-form-card text-center">
                    <div class="auth-hero-icon mx-auto mb-3" style="color: var(--status-serious);">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <span class="section-kicker mb-3"><i class="bi bi-lock-fill"></i> Temporary lockout</span>
                    <h1 class="auth-form-title mt-2 mb-2 fw-bold">Account locked</h1>
                    <p class="auth-form-subtitle mx-auto mb-4">This account has been locked out. Try again later or contact an administrator if the issue persists.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-premium-primary px-4 py-3 text-decoration-none">Back to Login</a>
                </div>
            </div>
        </section>
    </div>
</div>
