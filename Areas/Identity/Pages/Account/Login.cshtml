@page
@model LoginModel

@{
    ViewData["Title"] = "Access Portal";
}

<div class="container-fluid site-section">
    <div class="auth-shell">
        <section class="surface-panel auth-hero">
            <div class="auth-hero-panel">
                <div>
                    <div class="auth-hero-badge mb-3"><i class="bi bi-shield-lock-fill"></i> Access controlled entry</div>
                    <div class="auth-hero-icon mb-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h1 class="auth-hero-title fw-bold">Secure Sign In</h1>
                    <p class="auth-hero-copy mt-3 mb-0">
                        MediVault protects every session with role-based access, encrypted patient data, and a traceable audit trail.
                    </p>
                </div>

                <div class="auth-hero-stats">
                    <div class="auth-stat">
                        <strong>Encrypted</strong>
                        <span>Session traffic is protected by HTTPS</span>
                    </div>
                    <div class="auth-stat">
                        <strong>Audited</strong>
                        <span>Sign-ins and failures are recorded</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="surface-panel auth-form">
            <div class="auth-form-inner">
                <div class="auth-form-card">
                    <span class="section-kicker"><i class="bi bi-key-fill"></i> Credential gateway</span>
                    <h2 class="auth-form-title mt-3 mb-2 fw-bold">Welcome back</h2>
                    <p class="auth-form-subtitle mb-4">Enter your email and password to continue into the clinical portal.</p>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

                        <div class="auth-field mb-3">
                            <label asp-for="Input.Email" class="form-label">Email Address</label>
                            <input asp-for="Input.Email" class="form-control form-input-custom" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="auth-field mb-3">
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <input asp-for="Input.Password" class="form-control form-input-custom" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4 text-start">
                            <input class="form-check-input bg-transparent border-secondary" asp-for="Input.RememberMe" style="border-radius: 4px;" />
                            <label asp-for="Input.RememberMe" class="form-check-label text-muted small">
                                Keep me signed in for 30 days
                            </label>
                        </div>

                        <button id="login-submit" type="submit" class="w-100 btn btn-premium-primary py-3 mb-3">
                            <i class="bi bi-unlock-fill"></i> Sign In
                        </button>

                        <div class="auth-divider"></div>

                        <div class="d-flex flex-column gap-2 small">
                            <a id="forgot-password" asp-page="./ForgotPassword" class="auth-mini-link">Forgot password?</a>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
