@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="container-fluid site-section">
    <div class="auth-shell auth-shell--centered">
        <section class="surface-panel auth-form auth-form--centered">
            <div class="auth-form-inner">
                <div class="auth-form-card">
                    <span class="section-kicker"><i class="bi bi-shield-lock"></i> Password reset</span>
                    <h1 class="auth-form-title mt-3 mb-2 fw-bold">Reset your password</h1>
                    <p class="auth-form-subtitle mb-4">Choose a new password for your MediVault account.</p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>
                        <input asp-for="Input.Code" type="hidden" />

                        <div class="auth-field mb-3">
                            <label asp-for="Input.Email" class="form-label">Email Address</label>
                            <input asp-for="Input.Email" class="form-control form-input-custom" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="auth-field mb-3">
                            <label asp-for="Input.Password" class="form-label">New Password</label>
                            <input asp-for="Input.Password" class="form-control form-input-custom" autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="auth-field mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control form-input-custom" autocomplete="new-password" aria-required="true" placeholder="Please confirm your password." />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-premium-primary py-3">Reset Password</button>
                    </form>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
