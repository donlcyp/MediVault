@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="tfa-login-wrapper">
    <div class="tfa-login-card">

        <!-- Animated shield icon -->
        <div class="tfa-icon-wrap">
            <div class="tfa-icon-ring"></div>
            <div class="tfa-icon-inner">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
        </div>

        <div class="tfa-header">
            <span class="settings-eyebrow">Security checkpoint</span>
            <h1 class="tfa-title">Two-factor authentication</h1>
            <p class="tfa-subtitle">Your account is protected. Enter the 6-digit code from your authenticator app to continue.</p>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="tfa-form" id="tfa-login-form">
            <input asp-for="RememberMe" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="tfa-error-box" role="alert"></div>

            <div class="tfa-code-field">
                <label class="tfa-code-label">
                    <i class="bi bi-key-fill"></i>
                    Authenticator code
                </label>
                <input asp-for="Input.TwoFactorCode"
                       class="tfa-code-input"
                       autocomplete="one-time-code"
                       inputmode="numeric"
                       maxlength="7"
                       placeholder="000 000"
                       id="tfa-code-input" />
                <span asp-validation-for="Input.TwoFactorCode" class="tfa-field-error"></span>
            </div>

            <label class="tfa-remember-label" for="Input_RememberMachine">
                <input asp-for="Input.RememberMachine" class="tfa-remember-check" id="Input_RememberMachine" />
                <span class="tfa-remember-toggle"></span>
                <span>Remember this device for 30 days</span>
            </label>

            <button type="submit" class="tfa-submit-btn" id="tfa-submit">
                <i class="bi bi-arrow-right-circle-fill"></i>
                Verify &amp; Sign in
            </button>
        </form>

        <div class="tfa-recovery-row">
            <i class="bi bi-life-preserver"></i>
            <span>Lost your device?
                <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="tfa-recovery-link">
                    Sign in with a recovery code
                </a>
            </span>
        </div>

    </div>

    <!-- Decorative background blobs -->
    <div class="tfa-blob tfa-blob-1"></div>
    <div class="tfa-blob tfa-blob-2"></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-format: insert space after 3 digits
        const input = document.getElementById('tfa-code-input');
        if (input) {
            input.addEventListener('input', function () {
                let v = this.value.replace(/\D/g, '').slice(0, 6);
                if (v.length > 3) v = v.slice(0, 3) + ' ' + v.slice(3);
                this.value = v;
            });
        }
    </script>
}
