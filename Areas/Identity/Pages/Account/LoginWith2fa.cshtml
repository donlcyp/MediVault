@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid site-section">
    <div class="auth-shell auth-shell--centered">
        <section class="surface-panel auth-form auth-form--centered">
            <div class="auth-form-inner">
                <div class="auth-form-card">
                    <span class="section-kicker"><i class="bi bi-shield-lock-fill"></i> Security checkpoint</span>
                    <h1 class="auth-form-title mt-3 mb-2 fw-bold">Two-factor authentication</h1>
                    <p class="auth-form-subtitle mb-4">Enter the 6-digit code from your authenticator app to continue.</p>

                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" id="tfa-login-form">
                        <input asp-for="RememberMe" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

                        <div class="auth-field mb-3">
                            <label class="form-label">Authenticator code</label>
                            <input asp-for="Input.TwoFactorCode"
                                   class="form-control form-input-custom"
                                   autocomplete="one-time-code"
                                   inputmode="numeric"
                                   maxlength="7"
                                   placeholder="000 000"
                                   id="tfa-code-input" />
                            <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
                        </div>

                        <label class="form-check form-check-label d-flex align-items-center gap-2 mb-4" for="Input_RememberMachine">
                            <input asp-for="Input.RememberMachine" class="form-check-input" id="Input_RememberMachine" />
                            <span class="text-muted small">Remember this device for 30 days</span>
                        </label>

                        <button type="submit" class="w-100 btn btn-premium-primary py-3" id="tfa-submit">
                            <i class="bi bi-arrow-right-circle-fill"></i>
                            Verify &amp; Sign in
                        </button>
                    </form>

                    <div class="auth-divider"></div>
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <i class="bi bi-life-preserver text-gradient"></i>
                        <span>Lost your device?</span>
                        <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="auth-mini-link">Use a recovery code</a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-format: insert space after 3 digits
        const input = document.getElementById('tfa-code-input');
        if (input) {
            input.addEventListener('input', function () {
                let v = this.value.replace(/\D/g, '').slice(0, 6);
                if (v.length > 3) v = v.slice(0, 3) + ' ' + v.slice(3);
                this.value = v;
            });
        }
    </script>
}
