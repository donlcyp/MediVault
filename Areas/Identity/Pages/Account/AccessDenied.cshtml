@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="container-fluid site-section">
    <div class="auth-shell auth-shell--centered">
        <section class="surface-panel auth-form auth-form--centered">
            <div class="auth-form-inner">
                <div class="auth-form-card text-center">
                    <div class="auth-hero-icon mx-auto mb-3">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                    <span class="section-kicker mb-3"><i class="bi bi-ban"></i> Authorization blocked</span>
                    <h1 class="auth-form-title mt-2 mb-2 fw-bold">Access denied</h1>
                    <p class="auth-form-subtitle mx-auto mb-4">You do not have permission to view this resource.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-premium-primary px-4 py-3 text-decoration-none">Return to Login</a>
                </div>
            </div>
        </section>
    </div>
</div>
