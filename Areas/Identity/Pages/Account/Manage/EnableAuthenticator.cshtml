@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<div class="settings-section-header mb-4">
    <span class="settings-eyebrow">Required security step</span>
    <h3>@ViewData["Title"]</h3>
    <p class="text-muted mb-0">Connect an authenticator app to protect access to MediVault records.</p>
</div>

<div class="mfa-setup-grid">
    <section class="settings-panel mfa-instructions">
        <div class="settings-panel-title">
            <span class="settings-step">1</span>
            <div>
                <h4>Install an authenticator</h4>
                <p>Use Microsoft Authenticator or Google Authenticator on your phone.</p>
            </div>
        </div>
        <div class="app-link-grid">
            <a href="https://go.microsoft.com/fwlink/?Linkid=825072" class="settings-action-link">
                <i class="bi bi-android2"></i> Microsoft Android
            </a>
            <a href="https://go.microsoft.com/fwlink/?Linkid=825073" class="settings-action-link">
                <i class="bi bi-apple"></i> Microsoft iOS
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en" class="settings-action-link">
                <i class="bi bi-android2"></i> Google Android
            </a>
            <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" class="settings-action-link">
                <i class="bi bi-apple"></i> Google iOS
            </a>
        </div>

        <div class="settings-divider"></div>

        <div class="settings-panel-title">
            <span class="settings-step">2</span>
            <div>
                <h4>Enter your setup key</h4>
                <p>Use this key in the authenticator app. Spaces and casing do not matter.</p>
            </div>
        </div>
        <div class="setup-key-box">
            <span>@Model.SharedKey</span>
        </div>
        <div class="settings-note">
            <i class="bi bi-qr-code"></i>
            <span>QR generation can be enabled later. Manual key entry works now.</span>
        </div>
        <div id="qrCode"></div>
        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
    </section>

    <section class="settings-panel mfa-verify-panel">
        <div class="settings-panel-title">
            <span class="settings-step">3</span>
            <div>
                <h4>Verify the code</h4>
                <p>Enter the six-digit code from your authenticator app.</p>
            </div>
        </div>
        <form id="send-code" method="post" class="settings-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="form-floating mb-3 account-floating">
                <input asp-for="Input.Code" class="form-control form-input-custom" autocomplete="off" inputmode="numeric" placeholder="123456" />
                <label asp-for="Input.Code" class="control-label form-label">Verification Code</label>
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>
            <button type="submit" class="w-100 btn btn-premium-primary py-3">
                <i class="bi bi-shield-check"></i> Verify and Enable
            </button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
