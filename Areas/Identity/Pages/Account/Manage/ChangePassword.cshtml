@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="settings-section-header mb-4">
    <span class="settings-eyebrow">Password</span>
    <h3 class="mb-1">@ViewData["Title"]</h3>
    <p class="text-muted mb-0">Rotate credentials regularly to keep the account boundary tight.</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="settings-panel settings-form-panel">
    <div class="settings-panel-title">
        <span class="settings-step"><i class="bi bi-shield-lock"></i></span>
        <div>
            <h4>Change password</h4>
            <p>Use a strong password you have not reused elsewhere.</p>
        </div>
    </div>

    <form id="change-password-form" method="post" class="settings-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-floating mb-3">
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
            <label asp-for="Input.OldPassword" class="form-label"></label>
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
            <label asp-for="Input.NewPassword" class="form-label"></label>
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password."/>
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-premium-primary">Update password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
