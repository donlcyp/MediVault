@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

@{
    var currentTitle = ViewData["Title"]?.ToString() ?? "Account Settings";
}

<div class="container-fluid py-4 account-settings-page">
    <div class="account-settings-hero mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="settings-hero-icon">
                    <i class="bi bi-person-gear"></i>
                </div>
                <div>
                    <span class="settings-eyebrow">Identity center</span>
                    <h1 class="h2 mb-1">Account Settings</h1>
                    <p class="text-muted mb-0">Manage your profile, sign-in credentials, and authentication security.</p>
                </div>
            </div>
            <div class="settings-hero-card">
                <span class="badge-status badge-stable mb-2">Protected</span>
                <span class="d-block text-muted small">Current section</span>
                <strong>@currentTitle</strong>
            </div>
        </div>
    </div>

    <div class="account-settings-shell">
        <div class="row g-0">
            <aside class="col-lg-3 account-settings-nav border-end border-secondary border-opacity-10">
                <div class="account-settings-nav-inner">
                    <partial name="_ManageNav" />
                </div>
            </aside>
            <section class="col-lg-9 account-settings-content">
                <div class="account-settings-content-inner">
                    @RenderBody()
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
